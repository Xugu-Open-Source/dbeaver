<plugin>

    <extension point="org.jkiss.dbeaver.dataSourceView">
        <view id="org.jkiss.dbeaver.ext.xugu.dataSourceWizardView"
              dataSource="xugu"
              targetID="org.jkiss.dbeaver.ext.ui.newConnectionWizard"
              label="%dialog.connection.header"
              class="org.jkiss.dbeaver.ext.xugu.views.ConnectionPage"
              icon="icons/icon.png">
        </view>
        <view id="org.jkiss.dbeaver.ext.xugu.dataSourceEditorView"
              dataSource="xugu"
              targetID="org.jkiss.dbeaver.ext.ui.editConnectionDialog"
              label="%dialog.connection.header"
              class="org.jkiss.dbeaver.ext.xugu.views.ConnectionPage">
        </view>
    </extension>


    <extension point="org.eclipse.ui.commands">
        <category id="org.jkiss.dbeaver.ext.xugu" name="Xugu" description="Xugu Commands"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <image commandId="org.jkiss.dbeaver.ext.xugu.code.compile" icon="icons/compile.png"/>
    </extension>
    <extension point="org.eclipse.ui.bindings">
        <key commandId="org.jkiss.dbeaver.ext.xugu.code.compile" schemeId="org.jkiss.dbeaver.defaultKeyScheme" sequence="CTRL+F9"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler commandId="org.jkiss.dbeaver.ext.xugu.code.compile" class="org.jkiss.dbeaver.ext.xugu.actions.CompileHandler">
            <enabledWhen>
                <or>
                    <with variable="selection">
                        <count value="+"/>
                        <iterate operator="and">
                            <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                                <instanceof value="org.jkiss.dbeaver.ext.xugu.model.source.SourceObject"/>
                            </adapt>
                        </iterate>
                    </with>
                    <with variable="activePart">
                        <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                            <instanceof value="org.jkiss.dbeaver.ext.xugu.model.source.SourceObject"/>
                        </adapt>
                    </with>
                </or>
            </enabledWhen>
        </handler>
    </extension>

    <extension point="org.jkiss.dbeaver.databaseEditor">
        <editor id="source.declaration" class="org.jkiss.dbeaver.ext.xugu.editors.SourceDeclarationEditor" label="%editor.package.declaration.name" description="%editor.package.declaration.description" icon="#sql_text" position="additions_middle" contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder" embeddable="false">
            <objectType name="org.jkiss.dbeaver.ext.xugu.model.View"/>
            <objectType name="org.jkiss.dbeaver.ext.xugu.model.ProcedureStandalone"/>
            <objectType name="org.jkiss.dbeaver.ext.xugu.model.Package"/>
            <objectType name="org.jkiss.dbeaver.ext.xugu.model.Trigger"/>
            <objectType name="org.jkiss.dbeaver.ext.xugu.model.Udt"/>
        </editor>
        <editor id="source.definition" class="org.jkiss.dbeaver.ext.xugu.editors.SourceDefinitionEditor" label="%editor.package.body.name" description="%editor.package.body.description" icon="#sql_text" position="additions_middle" contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder" embeddable="false">
            <objectType name="org.jkiss.dbeaver.ext.xugu.model.Package"/>
        </editor>
        <editor id="source.definition" class="org.jkiss.dbeaver.ext.xugu.editors.SourceDefinitionEditor" label="%editor.package.body.name" description="%editor.udt.body.description" icon="#sql_text" position="additions_middle" contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder" embeddable="false">
            <objectType name="org.jkiss.dbeaver.ext.xugu.model.Udt"/>
        </editor>
        <editor id="schedulerJob.action" class="org.jkiss.dbeaver.ext.xugu.editors.SchedulerJobActionEditor" label="%editor.scheduler.job.action.name" description="%editor.schedulerJob.action.description" icon="#sql_text" position="additions_middle" contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder" embeddable="false">
            <objectType name="org.jkiss.dbeaver.ext.xugu.model.SchedulerJob"/>
        </editor>
        <editor id="source.ddl" class="org.jkiss.dbeaver.ext.xugu.editors.ObjectDdlEditor" label="DDL" description="DDL" icon="#sql_text" position="additions_middle" contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder">
            <objectType name="org.jkiss.dbeaver.ext.xugu.model.Table"/>
        </editor>
        <editor id="org.jkiss.dbeaver.ext.xugu.editors.UserEditorGeneral" class="org.jkiss.dbeaver.ext.xugu.editors.UserEditorGeneral" objectType="org.jkiss.dbeaver.ext.xugu.model.User" main="true" label="%editor.general.name" description="General user settings" icon="#user">
        </editor>
        <editor id="org.jkiss.dbeaver.ext.xugu.editors.RoleEditor" class="org.jkiss.dbeaver.ext.xugu.editors.RoleEditor" objectType="org.jkiss.dbeaver.ext.xugu.model.Role" main="true" label="%editor.general.name" description="General role settings" icon="#role">
        </editor>

    </extension>

    <extension point="org.eclipse.ui.menus">
        <menuContribution allPopups="false" locationURI="popup:org.eclipse.ui.popup.any?after=navigator_additions_end">
            <command commandId="org.jkiss.dbeaver.ext.xugu.code.compile">
                <visibleWhen checkEnabled="true"/>
            </command>
        </menuContribution>
    </extension>



    <extension point="org.eclipse.ui.editors">
    </extension>


    <extension point="org.eclipse.core.runtime.preferences">
        <initializer class="org.jkiss.dbeaver.ext.xugu.internal.PreferencesInitializer"/>
    </extension>
</plugin>
