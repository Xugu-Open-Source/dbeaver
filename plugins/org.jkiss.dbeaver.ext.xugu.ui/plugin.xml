<plugin>

    <extension point="org.jkiss.dbeaver.dataSourceView">
        <view id="org.jkiss.dbeaver.ext.xugu.dataSourceWizardView"
              dataSource="xugu"
              targetID="org.jkiss.dbeaver.ext.ui.newConnectionWizard"
              label="%dialog.connection.header"
              class="org.jkiss.dbeaver.ext.xugu.views.ConnectionPage"
              icon="icons/hgicon.png">
        </view>
        <view id="org.jkiss.dbeaver.ext.xugu.dataSourceEditorView"
              dataSource="xugu"
              targetID="org.jkiss.dbeaver.ext.ui.editConnectionDialog"
              label="%dialog.connection.header"
              class="org.jkiss.dbeaver.ext.xugu.views.ConnectionPage">
        </view>
    </extension>


    <extension point="org.eclipse.ui.commands">
        <category id="org.jkiss.dbeaver.ext.xugu" name="Xugu" description="Xugu Commands"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <image commandId="org.jkiss.dbeaver.ext.xugu.code.compile" icon="icons/compile.png"/>
    </extension>
    <extension point="org.eclipse.ui.bindings">
        <key commandId="org.jkiss.dbeaver.ext.xugu.code.compile" schemeId="org.jkiss.dbeaver.defaultKeyScheme" sequence="CTRL+F9"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler commandId="org.jkiss.dbeaver.ext.xugu.code.compile" class="org.jkiss.dbeaver.ext.xugu.actions.CompileHandler">
            <enabledWhen>
                <or>
                    <with variable="selection">
                        <count value="+"/>
                        <iterate operator="and">
                            <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                                <instanceof value="org.jkiss.dbeaver.ext.xugu.model.source.SourceObject"/>
                            </adapt>
                        </iterate>
                    </with>
                    <with variable="activePart">
                        <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                            <instanceof value="org.jkiss.dbeaver.ext.xugu.model.source.SourceObject"/>
                        </adapt>
                    </with>
                </or>
            </enabledWhen>
        </handler>
    </extension>

    <extension point="org.jkiss.dbeaver.databaseEditor">
        <editor id="source.declaration" class="org.jkiss.dbeaver.ext.xugu.editors.SourceDeclarationEditor" label="%editor.package.declaration.name" description="%editor.package.declaration.description" icon="#sql_text" position="additions_middle" contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder" embeddable="false">
            <objectType name="org.jkiss.dbeaver.ext.xugu.model.View"/>
            <objectType name="org.jkiss.dbeaver.ext.xugu.model.ProcedureStandalone"/>
            <objectType name="org.jkiss.dbeaver.ext.xugu.model.Package"/>
            <objectType name="org.jkiss.dbeaver.ext.xugu.model.Trigger"/>
            <objectType name="org.jkiss.dbeaver.ext.xugu.model.Udt"/>
        </editor>
        <editor id="source.definition" class="org.jkiss.dbeaver.ext.xugu.editors.SourceDefinitionEditor" label="%editor.package.body.name" description="%editor.package.body.description" icon="#sql_text" position="additions_middle" contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder" embeddable="false">
            <objectType name="org.jkiss.dbeaver.ext.xugu.model.Package"/>
        </editor>
        <editor id="source.definition" class="org.jkiss.dbeaver.ext.xugu.editors.SourceDefinitionEditor" label="%editor.package.body.name" description="%editor.udt.body.description" icon="#sql_text" position="additions_middle" contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder" embeddable="false">
            <objectType name="org.jkiss.dbeaver.ext.xugu.model.Udt"/>
        </editor>
        <editor id="schedulerJob.action" class="org.jkiss.dbeaver.ext.xugu.editors.SchedulerJobActionEditor" label="%editor.scheduler.job.action.name" description="%editor.schedulerJob.action.description" icon="#sql_text" position="additions_middle" contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder" embeddable="false">
            <objectType name="org.jkiss.dbeaver.ext.xugu.model.SchedulerJob"/>
        </editor>
        <editor id="source.ddl" class="org.jkiss.dbeaver.ext.xugu.editors.ObjectDdlEditor" label="DDL" description="DDL" icon="#sql_text" position="additions_middle" contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder">
            <objectType name="org.jkiss.dbeaver.ext.xugu.model.Table"/>
        </editor>
        <editor id="org.jkiss.dbeaver.ext.xugu.editors.UserEditorGeneral" class="org.jkiss.dbeaver.ext.xugu.editors.UserEditorGeneral" objectType="org.jkiss.dbeaver.ext.xugu.model.User" main="true" label="%editor.general.name" description="General user settings" icon="#user">
        </editor>
        <editor id="org.jkiss.dbeaver.ext.xugu.editors.RoleEditor" class="org.jkiss.dbeaver.ext.xugu.editors.RoleEditor" objectType="org.jkiss.dbeaver.ext.xugu.model.Role" main="true" label="%editor.general.name" description="General role settings" icon="#role">
        </editor>


        <configurator class="org.jkiss.dbeaver.ext.xugu.config.XuguConstraintConfigurator">
            <objectType name="org.jkiss.dbeaver.ext.xugu.model.TableConstraint"/>
        </configurator>

    </extension>

    <extension point="org.eclipse.ui.menus">
        <menuContribution allPopups="false" locationURI="popup:org.eclipse.ui.popup.any?after=navigator_additions_end">
            <command commandId="org.jkiss.dbeaver.ext.xugu.code.compile">
                <visibleWhen checkEnabled="true"/>
            </command>
        </menuContribution>
    </extension>



    <extension point="org.eclipse.ui.editors">
    </extension>


    <extension point="org.eclipse.core.runtime.preferences">
        <initializer class="org.jkiss.dbeaver.ext.xugu.internal.PreferencesInitializer"/>
    </extension>

    <!--弃用导出定义-->
<!--    <extension point="org.jkiss.dbeaver.task.ui">-->
<!--        <configurator type="xuguExportTool" class="org.jkiss.dbeaver.ext.xugu.tools.XuguTaskConfigurator"/>-->
<!--    </extension>-->

    <!-- 定义命令 -->
    <extension point="org.eclipse.ui.commands">
        <command
                id="org.jkiss.dbeaver.ext.xugu.tasks.ExportTool"
                name="导出数据库定义"
                categoryId="org.jkiss.dbeaver.core.database"/>
        <command
                id="org.jkiss.dbeaver.ext.xugu.tasks.BackupTool"
                name="备份数据对象"
                categoryId="org.jkiss.dbeaver.core.database"/>
        <command
                id="org.jkiss.dbeaver.ext.xugu.tasks.FileViewer"
                name="查看数据库文件"
                categoryId="org.jkiss.dbeaver.core.database"/>
        <command
                id="org.jkiss.dbeaver.ext.xugu.tasks.RestoreTool"
                name="恢复数据库对象"
                categoryId="org.jkiss.dbeaver.core.database"/>
        <command
                id="org.jkiss.dbeaver.ext.xugu.tasks.ResourceViewer"
                name="查看数据库资源"
                categoryId="org.jkiss.dbeaver.core.database"/>

        <command
                id="org.jkiss.dbeaver.ext.xugu.tasks.TransactionKiller"
                name="查杀数据库事务"
                categoryId="org.jkiss.dbeaver.core.database"/>

        <command id="org.jkiss.dbeaver.ext.xugu.tableDepend" name="%tools.tableDepend.label"/>
        <command id="org.jkiss.dbeaver.ext.xugu.viewDepend" name="%tools.tableDepend.label"/>
        <command id="org.jkiss.dbeaver.ext.xugu.triggerDepend" name="%tools.tableDepend.label"/>
        <command id="org.jkiss.dbeaver.ext.xugu.packageDepend" name="%tools.tableDepend.label"/>
        <command id="org.jkiss.dbeaver.ext.xugu.procedureDepend" name="%tools.tableDepend.label"/>
    </extension>

    <!-- 绑定命令处理器 -->
    <extension point="org.eclipse.ui.handlers">
        <handler
                commandId="org.jkiss.dbeaver.ext.xugu.tasks.ExportTool"
                class="org.jkiss.dbeaver.ext.xugu.tasks.ExportTool"/>.
        <handler
                commandId="org.jkiss.dbeaver.ext.xugu.tasks.BackupTool"
                class="org.jkiss.dbeaver.ext.xugu.tasks.BackupTool"/>
        <handler
                commandId="org.jkiss.dbeaver.ext.xugu.tasks.FileViewer"
                class="org.jkiss.dbeaver.ext.xugu.tasks.FileViewer"/>
        <handler
                commandId="org.jkiss.dbeaver.ext.xugu.tasks.RestoreTool"
                class="org.jkiss.dbeaver.ext.xugu.tasks.RestoreTool"/>
        <handler
                commandId="org.jkiss.dbeaver.ext.xugu.tasks.ResourceViewer"
                class="org.jkiss.dbeaver.ext.xugu.tasks.ResourceViewer"/>
        <handler
                commandId="org.jkiss.dbeaver.ext.xugu.tasks.TransactionKiller"
                class="org.jkiss.dbeaver.ext.xugu.tasks.TransactionKiller"/>
        <handler commandId="org.jkiss.dbeaver.ext.xugu.tableDepend"
                 class="org.jkiss.dbeaver.ext.xugu.tools.XuguToolTableDependHandler"/>
        <handler commandId="org.jkiss.dbeaver.ext.xugu.viewDepend"
                 class="org.jkiss.dbeaver.ext.xugu.tools.XuguToolViewDependHandler"/>
        <handler commandId="org.jkiss.dbeaver.ext.xugu.triggerDepend"
                 class="org.jkiss.dbeaver.ext.xugu.tools.XuguToolTriggerDependHandler"/>
        <handler commandId="org.jkiss.dbeaver.ext.xugu.packageDepend"
                 class="org.jkiss.dbeaver.ext.xugu.tools.XuguToolPackageDependHandler"/>
        <handler commandId="org.jkiss.dbeaver.ext.xugu.procedureDepend"
                 class="org.jkiss.dbeaver.ext.xugu.tools.XuguToolProcedureDependHandler"/>

    </extension>

    <!-- 添加到菜单 -->
    <extension point="org.eclipse.ui.menus">
        <menuContribution
                allPopups="false"
                locationURI="popup:org.eclipse.ui.popup.any?after=export_import">

            <menu
                    label="HighGoDDB 工具"
                    icon="icons/hgicon.png">
                <visibleWhen checkEnabled="true">
                    <with variable="selection">
                        <iterate ifEmpty="false">
                            <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">>
                                <or>
                                    <instanceof value="org.jkiss.dbeaver.ext.xugu.model.DataSource"/>
                                    <instanceof value="org.jkiss.dbeaver.ext.xugu.model.Schema"/>
                                </or>
                            </adapt>
                        </iterate>
                    </with>
                </visibleWhen>

                <!-- 子命令：导出数据库定义 -->
                <command
                        commandId="org.jkiss.dbeaver.ext.xugu.tasks.ExportTool"
                        label="导出数据库定义"
                        icon="icons/tool-img/export.png"
                        style="push"/>

                <command
                    commandId="org.jkiss.dbeaver.ext.xugu.tasks.BackupTool"
                    label="备份数据对象"
                    icon="icons/job_log.png"
                    style="push"/>

                <command
                        commandId="org.jkiss.dbeaver.ext.xugu.tasks.FileViewer"
                        label="查看数据库文件"
                        icon="icons/tool-img/FileViewer.png"
                        style="push"/>

                <command
                        commandId="org.jkiss.dbeaver.ext.xugu.tasks.RestoreTool"
                        label="恢复数据对象"
                        icon="icons/tool-img/RestoreTool.png"
                        style="push"/>
                <command
                        commandId="org.jkiss.dbeaver.ext.xugu.tasks.ResourceViewer"
                        label="查看数据资源"
                        icon="icons/tool-img/ResourceViewer.png"
                        style="push">
                    <visibleWhen checkEnabled="true">
                        <with variable="selection">
                            <iterate ifEmpty="false">
                                <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                                    <test property="org.jkiss.dbeaver.ext.xugu.isSystemDatabase" value="true"/>
                                </adapt>
                            </iterate>
                        </with>
                    </visibleWhen>

                </command>


                <command
                        commandId="org.jkiss.dbeaver.ext.xugu.tasks.TransactionKiller"
                        label="查杀数据库事务"
                        icon="icons/tool-img/TransactionKiller.png"

                        style="push">
                    <visibleWhen checkEnabled="true">
                        <with variable="selection">
                            <iterate ifEmpty="false">
                                <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                                    <test property="org.jkiss.dbeaver.ext.xugu.isSystemDatabase" value="true"/>
                                </adapt>
                            </iterate>
                        </with>
                    </visibleWhen>

                </command>


            </menu>

        </menuContribution>
    </extension>


    <extension point="org.jkiss.dbeaver.tools">
        <tools>
            <toolGroup
                    id="org.jkiss.dbeaver.ext.xugu.tools.maintenance"
                    label="Table Maintenance"
                    icon="#tools"/>
            <tool
                    description="%tools.tableDepend.description"
                    id="org.jkiss.dbeaver.ext.xugu.tools.XuGUToolTableDepend"
                    group="org.jkiss.dbeaver.ext.xugu.tools.maintenance"
                    label="%tools.tableDepend.label"
                    icon="#tableDepend"
                    singleton="false">
                <command id="org.jkiss.dbeaver.ext.xugu.tableDepend">
                    <objectType name="org.jkiss.dbeaver.ext.xugu.model.Table"/>
                </command>
                <command id="org.jkiss.dbeaver.ext.xugu.viewDepend">
                    <objectType name="org.jkiss.dbeaver.ext.xugu.model.View"/>
                </command>
                <command id="org.jkiss.dbeaver.ext.xugu.triggerDepend">
                    <objectType name="org.jkiss.dbeaver.ext.xugu.model.Trigger"/>
                </command>
                <command id="org.jkiss.dbeaver.ext.xugu.packageDepend">
                    <objectType name="org.jkiss.dbeaver.ext.xugu.model.Package"/>
                </command>
                <command id="org.jkiss.dbeaver.ext.xugu.procedureDepend">
                    <objectType name="org.jkiss.dbeaver.ext.xugu.model.ProcedureStandalone"/>
                </command>
            </tool>
        </tools>
    </extension>

</plugin>
