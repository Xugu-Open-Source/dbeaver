        <manager class="org.jkiss.dbeaver.ext.cae.edit.RoleAuthorityManager" objectType="org.jkiss.dbeaver.ext.cae.model.RoleAuthority"/>
    </extension>

    <extension point="org.jkiss.dbeaver.databaseEditor">
        <editor id="source.declaration" class="org.jkiss.dbeaver.ext.cae.editors.SourceDeclarationEditor" label="%editor.package.declaration.name" description="%editor.package.declaration.description" icon="#sql_text" position="additions_middle" contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder" embeddable="false">
            <objectType name="org.jkiss.dbeaver.ext.cae.model.View"/>
            <objectType name="org.jkiss.dbeaver.ext.cae.model.ProcedureStandalone"/>
            <objectType name="org.jkiss.dbeaver.ext.cae.model.Package"/>
            <objectType name="org.jkiss.dbeaver.ext.cae.model.Trigger"/>
            <objectType name="org.jkiss.dbeaver.ext.cae.model.Udt"/>
        </editor>
        <editor id="source.definition" class="org.jkiss.dbeaver.ext.cae.editors.SourceDefinitionEditor" label="%editor.package.body.name" description="%editor.package.body.description" icon="#sql_text" position="additions_middle" contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder" embeddable="false">
            <objectType name="org.jkiss.dbeaver.ext.cae.model.Package"/>
        </editor>
             <editor id="source.definition" class="org.jkiss.dbeaver.ext.cae.editors.SourceDefinitionEditor" label="%editor.package.body.name" description="%editor.udt.body.description" icon="#sql_text" position="additions_middle" contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder" embeddable="false">
            <objectType name="org.jkiss.dbeaver.ext.cae.model.Udt"/>
        </editor>
        <editor id="schedulerJob.action" class="org.jkiss.dbeaver.ext.cae.editors.SchedulerJobActionEditor" label="%editor.scheduler.job.action.name" description="%editor.schedulerJob.action.description" icon="#sql_text" position="additions_middle" contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder" embeddable="false">
            <objectType name="org.jkiss.dbeaver.ext.cae.model.SchedulerJob"/>
        </editor>
        <editor id="source.ddl" class="org.jkiss.dbeaver.ext.cae.editors.ObjectDdlEditor" label="DDL" description="DDL" icon="#sql_text" position="additions_middle" contributor="org.jkiss.dbeaver.ui.editors.sql.SQLEditorContributorNested" type="folder">
            <objectType name="org.jkiss.dbeaver.ext.cae.model.Table"/>
        </editor>
        <editor id="org.jkiss.dbeaver.ext.cae.editors.UserEditorGeneral" class="org.jkiss.dbeaver.ext.cae.editors.UserEditorGeneral" objectType="org.jkiss.dbeaver.ext.cae.model.User" main="true" label="%editor.general.name" description="General user settings" icon="#user">
        </editor>
        <editor id="org.jkiss.dbeaver.ext.cae.editors.RoleEditor" class="org.jkiss.dbeaver.ext.cae.editors.RoleEditor" objectType="org.jkiss.dbeaver.ext.cae.model.Role" main="true" label="%editor.general.name" description="General role settings" icon="#role">
        </editor>

    </extension>
    
    
    <extension point="org.jkiss.dbeaver.tools">
        <tools>
            <toolGroup
                id="org.jkiss.dbeaver.ext.cae.tools.maintenance"
                label="Table Maintenance"
                icon="#tools"/>
            <tool
                class="org.jkiss.dbeaver.ext.cae.tasks.ExportTool"	
                description="Export Object DDL"
                id="org.jkiss.dbeaver.ext.cae.tasks.ExportTool"
                label="导出对象定义"
                icon="#export"
                singleton="false">
                <objectType name="org.jkiss.dbeaver.ext.cae.model.DataSource"/>
                <objectType name="org.jkiss.dbeaver.ext.cae.model.Schema"/>
                <objectType name="org.jkiss.dbeaver.ext.cae.model.Role"/>
                <objectType name="org.jkiss.dbeaver.ext.cae.model.User"/>
                <objectType name="org.jkiss.dbeaver.ext.cae.model.View"/>
                <objectType name="org.jkiss.dbeaver.ext.cae.model.Sequence"/>
                <objectType name="org.jkiss.dbeaver.ext.cae.model.Package"/>
                <objectType name="org.jkiss.dbeaver.ext.cae.model.ProcedureStandalone"/>
                <objectType name="org.jkiss.dbeaver.ext.cae.model.Trigger"/>
                <objectType name="org.jkiss.dbeaver.ext.cae.model.Synonym"/>
                <objectType name="org.jkiss.dbeaver.ext.cae.model.Udt"/>
            </tool>
            <tool
                class="org.jkiss.dbeaver.ext.cae.tasks.BackupTool"	
                description="Backup Tool"
                id="org.jkiss.dbeaver.ext.cae.tasks.BackupTool"
                label="备份数据库对象"
                singleton="true">
                <objectType name="org.jkiss.dbeaver.ext.cae.model.DataSource"/>
            </tool>
            <tool
                class="org.jkiss.dbeaver.ext.cae.tasks.RestoreTool"	
                description="Restore Tool"
                id="org.jkiss.dbeaver.ext.cae.tasks.RestoreTool"
                label="恢复数据库对象"
                singleton="true">
                <objectType name="org.jkiss.dbeaver.ext.cae.model.DataSource"/>
            </tool>
            <tool
                class="org.jkiss.dbeaver.ext.cae.tasks.TransactionKiller"	
                description="Transaction Killer"
                id="org.jkiss.dbeaver.ext.cae.tasks.TransactionKiller"
                label="查杀数据库事务"
                singleton="true">
                <objectType name="org.jkiss.dbeaver.ext.cae.model.DataSource"/>
            </tool>
            <tool
                class="org.jkiss.dbeaver.ext.cae.tasks.FileViewer"	
                description="File Viewer"
                id="org.jkiss.dbeaver.ext.cae.tasks.FileViewer"
                label="查看数据库文件"
                singleton="true">
                <objectType name="org.jkiss.dbeaver.ext.cae.model.DataSource"/>
            </tool>
            <tool
                class="org.jkiss.dbeaver.ext.cae.tasks.ResourceViewer"	
                description="File Viewer"
                id="org.jkiss.dbeaver.ext.cae.tasks.ResourceViewer"
                label="查看数据库资源"
                singleton="true">
                <objectType name="org.jkiss.dbeaver.ext.cae.model.DataSource"/>
            </tool>
        </tools>
     </extension>
    

    <extension point="org.jkiss.dbeaver.dataTypeProvider">
        <provider class="org.jkiss.dbeaver.ext.cae.data.ValueHandlerProvider" description="Cae data types provider" id="org.jkiss.dbeaver.ext.cae.data.ValueHandlerProvider" label="Cae data types provider">

            <datasource id="cae"/>

            <type name="XMLTYPE"/>
            <type kind="CONTENT"/>
            <type kind="DATETIME"/>
            <type name="TIMESTAMP"/>
            <type name="TIMESTAMP WITH TZ"/>
            <type name="TIMESTAMP WITH LOCAL TZ"/>
            <type name="TIMESTAMP WITH TIME ZONE"/>
            <type name="TIMESTAMP WITH LOCAL TIME ZONE"/>
            <type name="TIMESTAMP WITH LOCAL TIME ZONE"/>
            <type name="GEOMETRY"/>
            <!--type standard="STRUCT"/-->

        </provider>
    </extension>
    <extension point="org.eclipse.ui.commands">
        <category id="org.jkiss.dbeaver.ext.cae" name="Cae" description="Cae Commands"/>
    </extension>

    <extension point="org.eclipse.ui.commandImages">
        <image commandId="org.jkiss.dbeaver.ext.cae.code.compile" icon="icons/compile.png"/>
    </extension>
    <extension point="org.eclipse.ui.bindings">
        <key commandId="org.jkiss.dbeaver.ext.cae.code.compile" schemeId="org.jkiss.dbeaver.defaultKeyScheme" sequence="CTRL+F9"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <handler commandId="org.jkiss.dbeaver.ext.cae.code.compile" class="org.jkiss.dbeaver.ext.cae.actions.CompileHandler">
            <enabledWhen>
                <or>
                    <with variable="selection">
                        <count value="+"/>
                        <iterate operator="and">
                            <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                                <instanceof value="org.jkiss.dbeaver.ext.cae.model.source.SourceObject"/>
                            </adapt>
                        </iterate>
                    </with>
                    <with variable="activePart">
                        <adapt type="org.jkiss.dbeaver.model.struct.DBSObject">
                            <instanceof value="org.jkiss.dbeaver.ext.cae.model.source.SourceObject"/>
                        </adapt>
                    </with>
                </or>
            </enabledWhen>
        </handler>
    </extension>

    <extension point="org.eclipse.ui.menus">
        <menuContribution allPopups="false" locationURI="popup:org.eclipse.ui.popup.any?after=navigator_additions_end">
            <command commandId="org.jkiss.dbeaver.ext.cae.code.compile">
                <visibleWhen checkEnabled="true"/>
            </command>
        </menuContribution>
    </extension>

    <extension point="org.eclipse.core.runtime.adapters">
        <factory adaptableType="java.lang.Object" class="org.jkiss.dbeaver.ext.cae.model.ObjectAdapter">
            <adapter type="org.jkiss.dbeaver.ext.cae.model.source.SourceObject"/>
        </factory>
    </extension>

    <extension point="org.eclipse.ui.editors">
    </extension>

    <extension point="org.jkiss.dbeaver.sqlDialect">
        <dialect id="cae" parent="basic" class="org.jkiss.dbeaver.ext.cae.model.SqlDialect" label="Cae" description="Cae SQL dialect." icon="icons/icon.png">
        </dialect>
    </extension>

    <!--MERGE(Cae) 语句生成拓展点-->
    <extension point="org.jkiss.dbeaver.sqlGenerator">
        <generator id="tableMerge" class="org.jkiss.dbeaver.ext.cae.model.sql.generator.SQLGeneratorMerge" label="MERGE(Cae)" description="MERGE table using Cae dialect" order="5">
            <objectType name="org.jkiss.dbeaver.model.struct.DBSDataManipulator"/>
        </generator>
    </extension>
    
    <extension point="org.eclipse.core.runtime.preferences">
        <initializer class="org.jkiss.dbeaver.ext.cae.internal.PreferencesInitializer"/>
    </extension>
</plugin>
