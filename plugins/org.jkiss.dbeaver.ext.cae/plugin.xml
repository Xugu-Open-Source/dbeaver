        <manager class="org.jkiss.dbeaver.ext.cae.edit.PackageManager" objectType="org.jkiss.dbeaver.ext.cae.model.Package"/>
      	<manager class="org.jkiss.dbeaver.ext.cae.edit.TriggerManager" objectType="org.jkiss.dbeaver.ext.cae.model.Trigger"/>
