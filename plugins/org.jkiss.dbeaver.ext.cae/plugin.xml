<plugin>

    <extension point="org.jkiss.dbeaver.dataSourceProvider">
        <datasource class="org.jkiss.dbeaver.ext.cae.DataSourceProvider" description="Cae connector" icon="icons/icon.png" id="cae" label="Cae" dialect="cae">
            <tree icon="icons/icon.png" label="Cae data source" path="cae">

                <!--模式-->
                <folder type="org.jkiss.dbeaver.ext.cae.model.Schema" label="%tree.schemas.node.name" icon="#folder_schema" description="Database schemas">
                    <items label="%tree.schema.node.name" path="schema" property="schemas" icon="#schema">
                        <icon if="object.system" icon="#schema_system"/>
                        <!--表-->
                        <folder type="org.jkiss.dbeaver.ext.cae.model.Table" label="%tree.tables.node.name" icon="#folder_table" description="Tables">
                            <items label="%tree.table.node.name" path="table" property="tables" icon="#table">
                                <!--列-->
                                <folder type="org.jkiss.dbeaver.ext.cae.model.TableColumn" label="%tree.columns.node.name" icon="#columns" description="Table columns">
                                    <items label="%tree.column.node.name" path="column" property="attributes" icon="#column">
                                    </items>
                                </folder> 
                                <!--约束-->
                                <folder type="org.jkiss.dbeaver.ext.cae.model.TableConstraint" label="%tree.constraints.node.name" icon="#constraints" description="Table constraints">
                                    <items label="%tree.constraint.node.name" path="constraint" property="constraints" icon="#unique-key">
                                        <items label="%tree.constraint_columns.node.name" path="column" property="attributeReferences" navigable="false" inline="true">
                                        </items>
                                    </items>
                                </folder>
                                <!--外键-->
                                <folder type="org.jkiss.dbeaver.ext.cae.model.TableForeignKey" label="%tree.foreign_keys.node.name" icon="#keys" description="Table keys">
                                    <items label="%tree.foreign_key.node.name" path="association" property="associations" icon="#foreign-key">
                                        <items label="%tree.foreign_key_columns.node.name" itemLabel="%tree.column.node.name" path="column" property="attributeReferences" navigable="false" inline="true">
                                        </items>
                                    </items>
                                </folder>
                                <!--触发器   -->
                                <folder type="org.jkiss.dbeaver.ext.cae.model.Trigger" label="%tree.triggers.node.name" icon="#triggers" description="Triggers">
                                    <items label="%tree.trigger.node.name" path="trigger" property="triggers" icon="#trigger">
                                        <items label="%tree.columns.node.name" itemLabel="%tree.column.node.name" path="column" property="columns" navigable="false" inline="false">
                                        </items>
                                    </items>
                                </folder>
                                <!--索引-->
                                <folder type="org.jkiss.dbeaver.ext.cae.model.TableIndex" label="%tree.indexes.node.name" icon="#indexes" description="Table indexes">
                                    <items label="%tree.index.node.name" path="index" property="indexes" icon="#index">
                                        <items label="%tree.index_columns.node.name" itemLabel="%tree.column.node.name" path="column" property="attributeReferences" navigable="false" inline="true">
                                        </items>
                                    </items>
                                </folder>
                                <!--表分区-->
                                <folder type="org.jkiss.dbeaver.ext.cae.model.TablePartition" label="%tree.partitions.node.name" icon="#partitions" description="Table partitions">
                                    <items label="%tree.partition.node.name" path="partition" property="partitions" icon="#partition">
                                    </items>
                                </folder>
                                <!--子分区-->
                                <folder type="org.jkiss.dbeaver.ext.cae.model.TableSubPartition" label="%tree.subpartitions.node.name" icon="#partitions" description="Table Subpartitions">
                                    <items label="%tree.subpartitions.node.name" path="subpartition" property="subPartitions" icon="#partition">
                                    </items>
                                </folder>
                            </items>
                        </folder>
                        <!--视图-->
                        <folder type="org.jkiss.dbeaver.ext.cae.model.View" label="%tree.views.node.name" icon="#folder_view" description="Views">
                            <items label="%tree.view.node.name" path="view" property="views" icon="#view">
                                <!--列-->
                                <items label="%tree.columns.node.name" itemLabel="%tree.column.node.name" path="column" property="attributes" icon="#column">
                                </items>
                            </items>
                        </folder>
                        <!--序列-->
                        <folder type="org.jkiss.dbeaver.ext.cae.model.Sequence" label="%tree.sequences.node.name" icon="#sequences" description="Sequences">
                            <items label="%tree.sequence.node.name" path="sequence" property="sequences" icon="#sequence">
                            </items>
                        </folder>
                        <!--包-->
                        <folder type="org.jkiss.dbeaver.ext.cae.model.Package" label="%tree.packages.node.name" icon="#packages" description="Packages">
                            <items label="%tree.package.node.name" path="package" property="packages" icon="#package">
                                <!--存储过程-->
                                <folder type="org.jkiss.dbeaver.ext.cae.model.NewProcedurePackaged" label="%tree.procedures.node.name" icon="#procedures" description="Procedures">
                                    <items label="%tree.procedures.node.name" itemLabel="%tree.procedure.node.name" path="procedure" property="NewProcedures" icon="#procedure" id="Procedure">
                                        <items label="%tree.scheduler.job.parameters.node.name" itemLabel="%tree.scheduler.job.parameter.node.name" path="argument" property="parameters" icon="#procedure"/>
                              	 	</items>
                                </folder>
                                <!--存储函数-->
                                <folder type="org.jkiss.dbeaver.ext.cae.model.NewProcedurePackaged" label="%tree.functions.node.name" icon="#functions" description="Functions">
                                    <items label="%tree.functions.node.name" itemLabel="%tree.function.node.name" path="function" property="NewFunctions" icon="#function" id="Functions">                
                                  	    <items label="%tree.scheduler.job.parameters.node.name" itemLabel="%tree.scheduler.job.parameter.node.name" path="argument" property="parameters" icon="#procedure"/>
                              	 	</items>
                                </folder>
                            </items>
                        </folder>
                        <!--存储过程-->
                        <folder type="org.jkiss.dbeaver.ext.cae.model.ProcedureStandalone" label="%tree.procedures.node.name" icon="#procedures" description="Procedures">
                            <items label="%tree.procedures.node.name" itemLabel="%tree.procedure.node.name" path="procedure" property="procedures" icon="#procedure" id="Procedure">
                                <items navigable="false" visibleIf="true" label="%tree.scheduler.job.parameters.node.name" itemLabel="%tree.scheduler.job.parameter.node.name" path="argument" property="parameters" icon="#procedure"/>
                            </items>
                        </folder>
                        <!--存储函数-->
                        <folder type="org.jkiss.dbeaver.ext.cae.model.ProcedureStandalone" label="%tree.functions.node.name" icon="#functions" description="Functions">
                            <items label="%tree.functions.node.name" itemLabel="%tree.function.node.name" path="function" property="functions" icon="#function" id="Functions">
                                <items navigable="false" visibleIf="true" label="%tree.scheduler.job.parameters.node.name" itemLabel="%tree.scheduler.job.parameter.node.name" path="argument" property="parameters" icon="#function"/>
                            </items>
                        </folder>
                        <!--触发器-->
                        <folder type="org.jkiss.dbeaver.ext.cae.model.Trigger" label="%tree.triggers.node.name" icon="#triggers" description="triggers">
                            <items label="%tree.trigger.node.name" path="trigger" property="Triggers" icon="#trigger">
                                <items label="%tree.columns.node.name" itemLabel="%tree.column.node.name" path="column" property="columns" navigable="false" inline="false" virtual="true">
                                </items>
                            </items>
                        </folder>
                        <!--同义词-->
                        <folder type="org.jkiss.dbeaver.ext.cae.model.Synonym" label="%tree.synonyms.node.name" icon="#synonyms" description="Synonyms">
                            <items label="%tree.synonym.node.name" path="synonym" property="synonyms" icon="#synonym"/>
                        </folder>
                        <!--自定义数据类型-->
                        <folder type="org.jkiss.dbeaver.ext.cae.model.Udt" label="%tree.Udts.node.name" icon="#data_types" description="UDTs">
                            <items label="%tree.Udt.node.name" path="Udt" property="Udts" icon="#data_types">
								<!--属性-->
                                <folder type="org.jkiss.dbeaver.ext.cae.model.DataTypeAttribute" label="%tree.attributes.node.name" icon="#attributes" description="Type attributes" visibleIf="true">
                                    <items label="%tree.attribute.node.name" path="attribute" property="attributes" icon="#attribute"/>
                                </folder>
								<!--方法-->
                                <folder type="org.jkiss.dbeaver.ext.cae.model.DataTypeMethod" label="%tree.methods.node.name" icon="#procedures" description="Type methods" visibleIf="true">
                                    <items label="%tree.method.node.name" path="method" property="methods" icon="#procedure">
                                        <items label="%tree.arguments.node.name" itemLabel="%tree.argument.node.name" path="parameter" property="parameters" icon="#argument" navigable="false" inline="false">
                                        </items>
                                    </items>
                                </folder>
                            </items>
                        </folder>
                    </items>
                </folder>
                <!--作业-->
                <folder type="org.jkiss.dbeaver.ext.cae.model.SchedulerJob" label="%tree.scheduler.jobs.node.name" icon="#scheduler_job_folder" description="Scheduler jobs">
                    <items label="%tree.scheduler.job.node.name" path="schedulerJob" property="schedulerJobs" icon="icons/scheduled_job.png">
                        <items label="%tree.scheduler.job.arguments.node.name" itemLabel="%tree.scheduler.job.argument.node.name" path="argument" property="arguments" icon="#argument"/>
                    </items>
                </folder>
                <!--存储管理-->
                <!--表空间-->
                <folder type="org.jkiss.dbeaver.ext.cae.model.Tablespace" label="%tree.tablespaces.node.name" icon="#tablespaces" description="Tablespaces">
                    <items label="%tree.tablespace.node.name" path="tablespace" property="tablespaces" icon="#tablespace">
                        <folder type="org.jkiss.dbeaver.ext.cae.model.DataFile" label="%tree.files.node.name" icon="#files" description="Data Files">
                            <items label="%tree.file.node.name" path="file" property="files" icon="#file"/>
                        </folder>
                    </items>
                </folder>
                <!--用户-->
                <folder type="org.jkiss.dbeaver.ext.cae.model.User" label="%tree.users.node.name" icon="#folder_user" description="Users">
                    	<items label="%tree.user.node.name" path="user" property="users" icon="#user">
                    	</items>
                </folder>
                <folder type="org.jkiss.dbeaver.ext.cae.model.Role" label="%tree.roles.node.name" icon="#folder_role" description="Roles">
                    	<items label="%tree.role.node.name" path="role" property="roles" icon="#user_group">
                    	</items>
                </folder>
                <!--全局元信息-->
                <folder type="org.jkiss.dbeaver.model.struct.DBSObject" label="%tree.global_metadata.node.name" icon="#logical" description="Global metadata objects">
                    <folder type="org.jkiss.dbeaver.ext.cae.model.DataType" label="%tree.types.node.name" icon="#data_types" description="Types">
                        <items label="%tree.data_type.node.name" path="type" property="localDataTypes" icon="#data_type"/>
                    </folder>
                    <folder type="org.jkiss.dbeaver.ext.cae.model.Synonym" label="%tree.synonyms.node.name" icon="#synonyms" description="Public synonyms">
                        <items label="%tree.synonym.node.name" path="synonym" property="publicSynonyms" icon="#synonym"/>
                    </folder>
                </folder>
            </tree>

            <drivers managable="true">
                <driver class="com.cae.cloudjdbc.Driver" defaultPort="5138" description="Cae JDBC driver." icon="icons/icon.png" iconBig="icons/icon_big.png" id="Cae SQL Server" label="Cae" promoted="true" sampleURL="jdbc:cae://{host}[:{port}]/{database}" useURL="false" webURL="" categories="sql">
                    <replace provider="generic" driver="cae"/>
                    <replace provider="cae" driver="cae"/>
                    <replace provider="cae" driver="xugu_oci"/>

                    <property name="recv_mode" value="2"/>
                    <property name="auto_commit" value="on"/>
                    <!-- <property name="lob_ret" value=""/> -->
                    <property name="iso_level" value="READ COMMITTED"/>
                    <property name="lock_timeout" value="3600000"/>
                    <property name="return_rowid" value="false"/>
                    <property name="sql_cursor" value="sql_cursor"/>
                    <property name="isCompatible" value="false"/>
                    <!--	<property name="iscompatibleqx" value="false"/> -->
                    <!--	<property name="ips" value=""/> -->
                    <property name="char_set" value="utf8"/>

                    <!--<file path="maven:/com.Cae.jdbc:ojdbc8:RELEASE" type="jar"/>-->

                    <file type="license" path="drivers/cae/LICENSE.txt" bundle="drivers.cae"/>
                    <file type="jar" path="drivers/cae/cloudjdbc-11.0.8.jar" bundle="drivers.cae"/>

                </driver>
            </drivers>
            <templates>
                <resolver type="SYSDBA" class="org.jkiss.dbeaver.ext.cae.model.resolvers.UserResolver" description="Current  user"/>
            </templates>
        </datasource>
    </extension>

    <extension point="org.jkiss.dbeaver.dataSourceView">
        <view id="org.jkiss.dbeaver.ext.cae.dataSourceWizardView" dataSource="cae" targetID="org.jkiss.dbeaver.ext.ui.newConnectionWizard" label="%dialog.connection.header" class="org.jkiss.dbeaver.ext.cae.views.ConnectionPage" icon="icons/icon.png">
        </view>
        <view id="org.jkiss.dbeaver.ext.cae.dataSourceEditorView" dataSource="cae" targetID="org.jkiss.dbeaver.ext.ui.editConnectionDialog" label="%dialog.connection.header" class="org.jkiss.dbeaver.ext.cae.views.ConnectionPage">
        </view>
    </extension>

